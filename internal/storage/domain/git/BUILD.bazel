load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "git",
    srcs = ["git.go"],
    importpath = "github.com/steveyegge/beads/internal/storage/domain/git",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/git",
        "//internal/gitenv",
        "//internal/storage/domain",
    ],
)

go_test(
    name = "git_test",
    srcs = [
        "git_test.go",
        "git_windows_test.go",
        "suite_test.go",
    ],
    embed = [":git"],
    deps = [
        "//internal/gitenv",
        "//internal/storage/domain",
        "@com_github_stretchr_testify//require",
        "@com_github_stretchr_testify//suite",
    ] + select({
        "@rules_go//go/platform:windows": [
            "@com_github_stretchr_testify//assert",
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

# --- begin go_srcs (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
    ),
    visibility = ["//:__subpackages__"],
)

# --- end go_srcs ---
